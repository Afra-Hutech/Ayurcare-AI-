# ─────────────────────────────────────────────────────────────────────────────
# AyurCare Docker environment template
# Copy this file to .env and fill in the values marked <required>.
#   cp .env.example .env
#
# docker-compose.yml reads this file automatically.
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ────────────────────────────────────────────────────────────────────

# Must be identical in both services — patient tokens generated by bot-brain
# are verified by doctor-portal (port 5001).
JWT_SECRET=change_me_to_a_long_random_string   # <required>

# ── doctor-portal (Node/Express — port 5001) ─────────────────────────────────

# MongoDB URI is overridden in docker-compose.yml to use the mongo service.
# Set this only if you point to an external Atlas cluster instead.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/doctor_portal

# LiveKit video consultations (optional for local dev)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# URL the doctor portal tells patients to open for video calls
PATIENT_APP_URL=http://localhost:5173

# Stripe payments — get test keys from https://dashboard.stripe.com/test/apikeys
# Test mode needs no PAN / KYC; just sign up with email.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY     # <required for payments>
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY # <required for payments>

# ── bot-brain (Python/FastAPI — port 5002) ────────────────────────────────────

# MongoDB URI is overridden in docker-compose.yml to use the mongo service.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ayurcare_bot

# Gemini API — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                                     # <required>
GEMINI_API_KEY_FALLBACK=                            # optional second key for quota failover

# Model chain — tried in order; first one that responds wins
GEMINI_MODEL_CHAIN=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro

# ── RAG retrieval tuning ──────────────────────────────────────────────────────
# Use bm25 in containers to avoid downloading the 200 MB cross-encoder model.
# Switch to cross_encoder for better answer quality once the model is cached.
RERANKER_MODE=bm25                 # cross_encoder | bm25 | off
TOP_K_FAISS=20
TOP_K_RERANK=5
RETRIEVAL_SUFFICIENCY_THRESHOLD=0.25
RETRIEVAL_CONTEXT_BUDGET_CHARS=6000

# Redis cache — leave blank to use the in-memory LRU (fine for a single instance)
REDIS_URL=

# ── Dev convenience auth (DISABLE IN PRODUCTION) ─────────────────────────────
DEV_LOCAL_AUTH=false
DEV_DEMO_EMAIL=
DEV_DEMO_PASSWORD=
