# DocConnect API — copy to `.env` and fill in

# Match ayurveda-app/bot-brain/.env (same cluster + JWT_SECRET)
MONGODB_URI=mongodb+srv://...

# JWT used by /api/auth — must match JWT_SECRET in ayurveda-app/bot-brain so patient login tokens work on this API
JWT_SECRET=change_me

# ── LiveKit (in-app video for online consultations) ──
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Patient portal base URL for join links in notifications
PATIENT_APP_URL=http://localhost:5173

# Vaidya AI (bot-brain) — proxies patient recommendation requests
BOT_BRAIN_URL=http://127.0.0.1:5002

# ── Appointment notifications (email / SMS) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DocConnect <noreply@yourdomain.com>

# SMS & WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
