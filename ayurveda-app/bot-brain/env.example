# Copy to .env and fill in values.

GEMINI_API_KEY=
# Second key — used automatically when the primary hits quota / rate limits (never commit real keys here)
GEMINI_API_KEY_FALLBACK=

# Comma-separated model IDs, tried in order until one succeeds.
# When a model hits quota / rate limits / overload, the next ID is used automatically.
# Example:
# GEMINI_MODEL_CHAIN=gemini-2.0-flash,gemini-2.5-flash-preview-05-20,gemini-1.5-pro,gemma-3-27b-it
GEMINI_MODEL_CHAIN=gemma-4-26b-a4b-it,gemini-2.0-flash,gemini-2.0-flash-001,gemini-1.5-flash,gemini-1.5-pro,gemma-3-27b-it

# Legacy single-model hint (optional). Appended to the chain if not already listed.
model=gemini-2.0-flash

MONGODB_URI=
# Must match doctor-portal/server JWT_SECRET so patient tokens verify on port 5001 (wellness, appointments, chat).
JWT_SECRET=

# Local dev when MongoDB Atlas is unreachable (NEVER enable in production)
DEV_LOCAL_AUTH=true
DEV_DEMO_EMAIL=demo@ayurcare.com
DEV_DEMO_PASSWORD=demo1234

# ── RAG retrieval tuning ──────────────────────────────────────────────────────

# FAISS over-fetch size before reranking (more = better recall, slower FAISS pass)
TOP_K_FAISS=20
# Final top-k passages delivered to the LLM after reranking
TOP_K_RERANK=5
# Avg rerank score below which retrieval is flagged as sparse
# (0–1 scale for cross_encoder; 0–∞ for bm25/off — tune after checking logs)
RETRIEVAL_SUFFICIENCY_THRESHOLD=0.25
# Hard character cap on retrieved text injected into the LLM context window
RETRIEVAL_CONTEXT_BUDGET_CHARS=6000

# ── Reranker mode ─────────────────────────────────────────────────────────────
# Choose the reranking strategy.  Trade-offs:
#
#   cross_encoder  Best quality — sentence-transformers CrossEncoder rescores every
#                  FAISS candidate pair (query, chunk).  Adds ~100-300 ms per request
#                  and loads a ~200 MB model into RAM.  Recommended for low-medium traffic
#                  where answer quality matters most (e.g. a clinical assistant).
#
#   bm25           Medium quality — lightweight keyword-overlap scoring, no extra model,
#                  ~5 ms overhead.  Good for high-traffic or memory-constrained deployments
#                  when you still want *some* reranking beyond pure cosine similarity.
#
#   off            No reranking — keeps top-k by FAISS cosine score directly.
#                  Fastest and lowest memory; quality depends entirely on the embedding
#                  model.  Use when latency is the absolute priority.
#
# Default: cross_encoder (falls back to bm25 automatically if the model cannot load)
RERANKER_MODE=cross_encoder

# HuggingFace model ID used when RERANKER_MODE=cross_encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Cache (Redis for multi-instance deployments) ──────────────────────────────
# Leave REDIS_URL blank to use the in-memory LRU (single-process / dev).
# Set it to share the cache across all worker replicas in production.
# Example: redis://redis:6379/0   or   rediss://user:pass@host:6380/0  (TLS)
REDIS_URL=
# How long retrieval results are cached (seconds).  Longer = fewer FAISS calls.
RETRIEVAL_CACHE_TTL=3600
# How long specialist report results are cached (seconds).
SPECIALIST_CACHE_TTL=1800
