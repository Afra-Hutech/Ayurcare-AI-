{
  "name": "ayurcare-ai-tests",
  "version": "1.0.0",
  "description": "Unified test suite for AyurCare AI — Groups 3 and 4",
  "private": true,
  "scripts": {
    "test:security":    "jest api/test_doctor_portal_security.test.js --forceExit --verbose",
    "test:persistence": "jest api/test_report_persistence.test.js     --forceExit --verbose",
    "test:api":         "jest --config api/jest.config.js             --forceExit --verbose",
    "test:frontend":    "jest --config frontend/jest.config.js        --forceExit --verbose",
    "test:js":          "npm run test:api && npm run test:frontend"
  },
  "devDependencies": {
    "@babel/core":                "^7.24.0",
    "@babel/preset-env":          "^7.24.0",
    "@babel/preset-react":        "^7.23.3",
    "@testing-library/jest-dom":  "^6.4.0",
    "@testing-library/react":     "^15.0.0",
    "babel-jest":                 "^29.7.0",
    "jest":                       "^29.7.0",
    "jest-environment-jsdom":     "^29.7.0",
    "jsonwebtoken":               "^9.0.2",
    "supertest":                  "^7.0.0"
  },
  "dependencies": {
    "mongoose":   "^8.3.0",
    "sequelize":  "^6.37.3",
    "pg":         "^8.11.5",
    "pg-hstore":  "^2.3.4",
    "uuid":       "^9.0.1"
  }
}
